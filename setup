#!/bin/bash

cd -- "$(dirname -- "${BASH_SOURCE[0]}")" || exit 1

ask() {
    local question="$1"
    local default="${2:-n}"
    local prompt="y/N"
    local answer

    if [[ "$default" == "y" ]]; then
        prompt="Y/n"
    fi

    printf '%s? [%s]: ' "$question" "$prompt"
    IFS= read -r answer || return 1

    answer="${answer:-$default}"
    [[ "${answer,,}" == "y" || "${answer,,}" == "yes" ]]
}

clean() {
    printf 'Cleaning build files ...\n'
    rm -rf -- build src/kandinsky.egg-info || return 1

    if [[ -d dist && -n "$(ls -A -- dist)" ]]; then
        if ! ask "'dist' folder is not empty, remove it"; then
            return 0
        fi
    fi

    rm -rf -- dist
}

if [[ $# -eq 1 && "$1" == "-c" ]]; then
    clean
    exit $?
fi

if [[ $# -ne 0 ]]; then
    printf 'Usage: %s [-c]\n' "$0" >&2
    exit 2
fi

clean || exit 1

VENV_DIR=".venv"
PYTHON="$VENV_DIR/bin/python"

if [[ ! -x "$PYTHON" ]]; then
    printf '\nCreating virtual environment ...\n'
    python3 -m venv "$VENV_DIR" || exit 1
fi

printf '\nInstalling build dependencies ...\n'
"$PYTHON" -m pip install -U build || exit 1

printf '\nBuilding library ...\n'
"$PYTHON" -m build || exit 1

printf '\n'
if ask "Install library"; then
    if ask "Install optional dependencies"; then
        "$PYTHON" -m pip install '.[utilities]' || exit 1
    else
        "$PYTHON" -m pip install . || exit 1
    fi
fi

printf '\n'
if ask "Clear setup files" y; then
    clean || exit 1
fi

"$PYTHON" setup.py --version-null || exit 1
printf 'All done\n'